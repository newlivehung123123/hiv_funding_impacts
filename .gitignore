# generated data artifacts (regenerated by the collection run; may be large)
data/panel/
data/raw/*
*.sqlite
*.parquet

# The one raw file that is committed. ForeignAssistance.gov sits behind a Cloudflare challenge
# that answers 403 to every non-browser client, so its Complete Data Set can only be downloaded
# by hand, and the IATI files the connector reads instead do not carry the years before FY2012
# for State and Health and Human Services or before FY2020 for USAID. history_fa_gov.csv is the
# small extract of that hand-downloaded file, made once by scripts/extract_fa_history.py. Left
# ignored, a fresh clone would have no early PEPFAR years and no way to get them except a
# 3.7 GB manual download.
!data/raw/foreign_assistance/
data/raw/foreign_assistance/*
!data/raw/foreign_assistance/history_fa_gov.csv
!data/raw/foreign_assistance/history_fa_gov.json

# python
__pycache__/
*.pyc
.venv/
venv/
.env

# os
.DS_Store

# boundary files fetched by scripts/make_region_art.py --fetch (regenerable)
data/reference/

# the zip is only a fallback for hand-uploading; deploy.py is the way in
hivfundingimpacts-site.zip

# built site (regenerated by scripts/build_site.py)
site/dist/

# session hand-over notes, never committed
RESUME.md

# Phase 5 working folder. The notes, the builders, the parse outputs and the download list
# (dl2.json) are committed. The downloaded files, the saved web pages, the OCR scratch and
# the note backups are not, since dl2.json records where every download came from.
research/phase5_lac/dl/
research/phase5_lac/r2h_*.html
research/phase5_lac/ocr_tto/
research/phase5_lac/bak_*.md

# Editor and assistant settings
.claude/
